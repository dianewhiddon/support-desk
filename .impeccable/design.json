  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Gold primary action with an ink label.",
      "html": "<button class=\"ds-primary\">Send and resolve</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;border:1px solid var(--action-bg);border-radius:var(--radius);background:var(--action-bg);color:var(--action-ink);font:600 14px/1.2 var(--font);text-decoration:none;cursor:pointer;}.ds-primary:hover{background:var(--action-hover);border-color:var(--action-hover);color:var(--action-ink)}.ds-primary:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }.ds-primary:disabled{background:var(--line);border-color:var(--line);color:var(--ink-soft);cursor:not-allowed}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary draft or recording action.",
      "html": "<button class=\"ds-ghost\">Save draft</button>",
      "css": ".ds-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;border:1px solid var(--action-bg);border-radius:var(--radius);background:var(--action-bg);color:var(--action-ink);font:600 14px/1.2 var(--font);text-decoration:none;cursor:pointer;background:transparent;color:var(--ink);border-color:var(--line)}.ds-ghost:hover{background:var(--hover);border-color:var(--ink-faint)}.ds-ghost:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible label and full-width field.",
      "html": "<label class=\"ds-label\" for=\"ds-field\">Subject</label><input class=\"ds-input\" id=\"ds-field\" type=\"text\" value=\"Update the contact page\">",
      "css": ".ds-label{display:block;margin:0 0 6px;color:var(--ink);font:600 14px var(--font)}.ds-input{width:100%;min-height:44px;padding:10px 12px;border:1px solid var(--line);border-radius:var(--radius);background:var(--card);color:var(--ink);font:400 15px/1.5 var(--font)}.ds-input:focus{outline:2px solid var(--accent);outline-offset:0;border-color:var(--accent)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Active page uses an inset accent underline.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><a href=\"#queue\" aria-current=\"page\">Queue</a><a href=\"#clients\">Clients</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;padding:0 10px;color:var(--ink-soft);border-radius:var(--radius);font:550 14px/1.6 var(--font);text-decoration:none}.ds-nav a:hover{color:var(--ink);background:var(--hover)}.ds-nav a[aria-current]{color:var(--ink);box-shadow:inset 0 -2px 0 var(--accent)}.ds-nav a:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }"
    },
    {
      "name": "Open Status",
      "kind": "chip",
      "refersTo": "status-open",
      "description": "Textual state with accent tint.",
      "html": "<span class=\"ds-status\">Open</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;padding:3px 10px;border:1px solid var(--accent-line);border-radius:var(--radius);background:var(--accent-soft);color:var(--accent);font:650 12px/1.6 var(--font);letter-spacing:.03em;text-transform:uppercase;white-space:nowrap}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat bordered content surface.",
      "html": "<section class=\"ds-card\">Request details</section>",
      "css": ".ds-card{padding:20px;background:var(--card);color:var(--ink);border:1px solid var(--line);border-radius:var(--radius);font:400 15px/1.6 var(--font)}@media(max-width:620px){.ds-card{padding:16px}}"
    },
    {
      "name": "Owner Message",
      "kind": "custom",
      "refersTo": "owner-message",
      "description": "Accent-tinted owner message within a neutral conversation.",
      "html": "<div class=\"ds-thread\"><article class=\"ds-message\"><strong>Owner</strong><p>The page is updated.</p></article></div>",
      "css": ".ds-thread{display:flex;padding:20px;background:var(--thread-canvas);border:1px solid var(--line);border-radius:var(--radius)}.ds-message{width:100%;max-width:min(86%,760px);padding:14px 18px 16px;background:var(--accent-soft);color:var(--ink);border:1px solid var(--accent-line);border-radius:var(--radius);font:400 15px/1.65 var(--font)}.ds-message p{margin:10px 0 0}@media(max-width:620px){.ds-thread{padding:16px}.ds-message{max-width:calc(100% - 16px);padding:14px 16px}}"
    },
    {
      "name": "File Drop Area",
      "kind": "input",
      "refersTo": "dropzone",
      "description": "Clickable file area with focus feedback.",
      "html": "<label class=\"ds-drop\">Drop files here or tap to browse<input class=\"ds-file\" type=\"file\" aria-label=\"Attach files\"></label>",
      "css": ".ds-drop{display:grid;place-items:center;gap:4px;min-height:104px;padding:18px;border:1px dashed var(--ink-faint);border-radius:var(--radius);background:var(--card);color:var(--ink-soft);text-align:center;cursor:pointer;font:600 14px/1.6 var(--font)}.ds-drop:hover{border-color:var(--accent);background:var(--hover)}.ds-drop:focus-within{outline:2px solid var(--accent);outline-offset:2px}.ds-file{position:absolute;width:1px;height:1px;opacity:0;overflow:hidden}"
    },
    {
      "name": "Remove File",
      "kind": "button",
      "refersTo": "file-remove",
      "description": "Accessible 44px target around an SVG cross.",
      "html": "<button class=\"ds-remove\" aria-label=\"Remove attachment\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m6 6 12 12M6 18 18 6\" /></svg></button>",
      "css": ".ds-remove{width:44px;height:44px;border:0;background:transparent;color:var(--ink-soft);cursor:pointer}.ds-remove svg{vertical-align:middle}.ds-remove:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }"
    },
    {
      "name": "Request Row",
      "kind": "custom",
      "refersTo": "request-row",
      "description": "Linked request with supporting metadata.",
      "html": "<a class=\"ds-row\" href=\"#request\"><span><strong>Update the contact page</strong><span class=\"ds-sub\">Website request</span></span></a>",
      "css": ".ds-row{display:flex;align-items:center;gap:14px;padding:16px 18px;background:var(--card);border-bottom:1px solid var(--line-soft);color:var(--ink);text-decoration:none;font:400 15px/1.6 var(--font)}.ds-row strong{font-weight:550}.ds-sub{display:block;color:var(--ink-faint);font-size:13px}.ds-row:hover{background:var(--hover)}.ds-row:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }"
    }
  ],
  "narrative": {
    "northStar": "The Working Desk",
    "overview": "A compact working desk built from neutral surfaces, clear type and restrained gold. Borders and tonal changes separate requests, conversations and controls without decorative depth.\n\nLight and dark themes retain the same hierarchy and geometry. The interface preserves the incumbent Operate layout and system typography; it introduces no separate display identity.",
    "keyCharacteristics": [
      "Neutral surfaces with gold actions and theme-aware accents.",
      "Compact hierarchy, visible focus and 44px principal controls.",
      "Flat bordered containers with 3px corners.",
      "Responsive request rows and aligned conversation messages."
    ],
    "rules": [
      {
        "name": "The Theme Pair Rule",
        "body": "Switch the complete token set with the root theme attribute; preserve each token's role across themes. Frontmatter components describe the light defaults; runtime CSS variables supply their dark counterparts.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use borders and tonal contrast for structure; reserve the existing shadow forms for selection indicators.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use theme tokens for surfaces, text, borders and semantic status.",
      "Do retain ink labels on gold primary actions.",
      "Do keep visible focus and 44px targets for buttons, navigation and disclosure controls.",
      "Do pair status color with a readable text label.",
      "Do use inline SVG for control icons."
    ],
    "donts": [
      "Don't introduce decorative shadows or animation.",
      "Don't replace the approved neutral and gold palette with a new visual identity.",
      "Don't turn private-note styling into ordinary client-message styling."
    ]
  }
}
