---
import Base from '../../layouts/Base.astro';
import MessageFields from '../../components/MessageFields.astro';
import ThreadEntry from '../../components/ThreadEntry.astro';
import LinkedText from '../../components/LinkedText.astro';
import { env } from 'cloudflare:workers';
import { appConfig } from '../../lib/config.js';
import { getTicketByRef, listAttachments, listMessages, getSiteById } from '../../lib/db.js';
import { clientStatusLabel, fmtDateTime, parseLinksJson, safeHref, THREAD_VISIBLE } from '../../lib/render.js';
import { attachmentHref } from '../../lib/attachments.js';
import { requestReceivedCopy } from '../../lib/email.js';

const client = Astro.locals.client;
const config = appConfig(env);
const ticket = await getTicketByRef(env.DB, Astro.params.ref);
if (!ticket || ticket.client_id !== client.id) return Astro.redirect('/dashboard');

const [attachments, messages, site] = await Promise.all([
  listAttachments(env.DB, ticket.id),
  listMessages(env.DB, ticket.id),
  ticket.site_id ? getSiteById(env.DB, ticket.site_id) : null,
]);
// Clients see the conversation only, never private notes.
const visible = messages.filter((message) => message.visibility === 'client');
const timeZone = client.time_zone || config.timeZone;
const filesFor = (messageId) => attachments
  .filter((file) => (file.message_id ?? null) === messageId)
  .map((file) => ({ kind: String(file.content_type).startsWith('audio/') ? 'audio' : 'file', href: attachmentHref(file.id), label: file.filename || 'File' }));
const linksFor = (json) => parseLinksJson(json).map((link) => ({ kind: 'link', href: safeHref(link), label: 'Open link' }));
const folded = visible.length > THREAD_VISIBLE + 2;

const params = Astro.url.searchParams;
const created = params.get('created') === '1';
const replySent = params.get('reply') === 'sent';
const replyError = params.get('reply') === 'error';
const thanks = params.get('thanks');
const finished = ticket.status === 'done';
const received = requestReceivedCopy(ticket.type, config.ownerName, { onPage: true });
---
<Base title={ticket.ref}>
  <a class="crumb" href="/dashboard">← Your requests</a>
  {created && <div class="notice ok created-note" role="status"><strong>{received.heading}</strong> {received.body}</div>}

  <div class="page-head">
    <div>
      <p class="muted" style="margin:0;">{ticket.ref}{site ? ` · ${site.label || site.url}` : ''}</p>
      <h1>{ticket.title}</h1>
      <p class="hint">Sent {fmtDateTime(ticket.created_at, timeZone)}</p>
    </div>
    <span class:list={['pill', ticket.status]}>{clientStatusLabel(ticket, config.ownerName)}</span>
  </div>

  <section aria-label="Conversation" class="thread">
    <ThreadEntry tone="client" side="end" name="You" role={ticket.type === 'question' ? 'Your question' : 'Your request'}
      files={[...filesFor(null), ...linksFor(ticket.links)]}>
      <p><LinkedText body={ticket.body} /></p>
      {ticket.page && <p class="hint">Page: {ticket.page}</p>}
    </ThreadEntry>
    {folded && <details class="thread-earlier"><summary><span class="when-closed">Show {visible.length - THREAD_VISIBLE} earlier messages</span><span class="when-open">Hide earlier messages</span></summary></details>}
    {visible.map((message, index) => (
      <ThreadEntry
        tone={message.author === 'client' ? 'client' : 'owner'}
        side={message.author === 'client' ? 'end' : 'start'}
        name={message.author === 'client' ? 'You' : config.ownerName}
        role={message.author === 'client' ? '' : config.businessName}
        time={fmtDateTime(message.created_at, timeZone)}
        earlier={folded && index < visible.length - THREAD_VISIBLE}
        files={[...filesFor(message.id), ...linksFor(message.links)]}
      >
        <p><LinkedText body={message.body} /></p>
      </ThreadEntry>
    ))}
    {visible.length === 0 && !created && <p class="thread-empty">No replies yet. You will get an email when there is one.</p>}
  </section>

  {finished && !replySent && (
    thanks === '1' ? <div class="notice ok" style="margin-top:20px;">Thank you.</div>
    : thanks === '0' ? <div class="notice ok" style="margin-top:20px;">Got it. {config.ownerName} has been told and this request is open again.</div>
    : <div class="card" style="margin-top:20px;">
        <h2>Did this land right?</h2>
        <div class="actions">
          <form method="POST" action={`/api/tickets/${ticket.ref}/feedback`} class="inline-form">
            <input type="hidden" name="ok" value="1" />
            <button class="btn btn-ghost" type="submit">Yes, all good</button>
          </form>
        </div>
        <details style="margin-top:12px;">
          <summary style="cursor:pointer;min-height:44px;display:inline-flex;align-items:center;font-weight:600;">Something is off</summary>
          <form method="POST" action={`/api/tickets/${ticket.ref}/feedback`} style="margin-top:10px;">
            <input type="hidden" name="ok" value="0" />
            <div class="field"><label for="feedback-note">What needs another look?</label><textarea id="feedback-note" name="note" required maxlength="2000" style="min-height:90px;"></textarea></div>
            <button class="btn" type="submit">Send</button>
          </form>
        </details>
      </div>
  )}

  <section class="card" id="reply" aria-labelledby="reply-heading" style="margin-top:20px;">
    <h2 id="reply-heading">Reply to {config.ownerName}</h2>
    {replySent && <div class="notice ok" role="status">Reply sent.</div>}
    {replyError && <div class="notice err" role="alert">Your reply was not sent. Your words are saved in this browser; check the form and try again.</div>}
    <form method="POST" action={`/api/tickets/${ticket.ref}/reply`} enctype="multipart/form-data" data-reply-form data-draft-key={`desk-reply-${ticket.ref}`}>
      <input type="hidden" name="idempotency_key" value={crypto.randomUUID()} />
      <div class="field">
        <label for="reply-body">Your reply</label>
        <textarea id="reply-body" name="body" required maxlength="12000" data-message-body autofocus={params.get('reply') === '1'}></textarea>
      </div>
      <MessageFields idPrefix="reply" />
      <button class="btn btn-accent" type="submit" data-reply-submit>Send reply</button>
    </form>
  </section>
</Base>

<script define:vars={{ clearKeys: [created ? `desk-new-request-${client.id}` : '', replySent ? `desk-reply-${ticket.ref}` : ''] }}>
  for (const key of clearKeys) if (key) try { localStorage.removeItem(key); } catch (e) {}
  const form = document.querySelector('[data-reply-form]');
  const body = form?.querySelector('[data-message-body]');
  const submit = form?.querySelector('[data-reply-submit]');
  const key = form?.dataset.draftKey;
  try { if (body && key && !body.value) body.value = localStorage.getItem(key) || ''; } catch (e) {}
  body?.addEventListener('input', () => { try { localStorage.setItem(key, body.value); } catch (e) {} });
  form?.addEventListener('submit', (event) => {
    if (event.defaultPrevented) return;
    submit.disabled = true;
    submit.textContent = 'Sending…';
  });
</script>
