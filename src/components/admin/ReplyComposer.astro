---
/* The reply editor. Saving keeps the draft (and its files) private. Sending
   publishes the saved draft and moves the request on. Files upload as you pick
   them, after the draft is saved, so an upload always belongs to a draft. */
import { parseStoredDate } from '../../lib/render.js';
const { ticket, draft = null, files = [], clientLabel, aiEnabled = false } = Astro.props;
// A draft still "pending" after two minutes was cut off; treat it as failed.
const pendingAt = parseStoredDate(draft?.updated_at);
const writing = draft?.status === 'pending' && pendingAt && Date.now() - pendingAt.getTime() < 120_000;
const failed = draft?.status === 'error' || (draft?.status === 'pending' && !writing);
const aiReady = draft?.status === 'ready' && draft?.source === 'ai' && draft?.body;
---
{writing && <div class="notice warn" role="status">Claude is writing a draft. Reload in a moment to see it.</div>}
{failed && aiEnabled && <div class="notice err" role="status">The AI draft did not finish{draft?.error ? `: ${draft.error}` : '.'} Use Draft with AI to try again.</div>}
{aiReady && <div class="notice" role="status">Drafted by AI. Read and edit it before you send.</div>}
<form class="composer" method="POST" action={`/api/admin/tickets/${ticket.ref}/reply`} data-json-form data-reply-draft>
  <input type="hidden" name="idempotency_key" value={crypto.randomUUID()} />
  <input type="hidden" name="ticket_revision" value={ticket.revision} />
  <input type="hidden" name="draft_id" value={draft?.id || ''} />
  <input type="hidden" name="draft_revision" value={draft?.revision ?? 0} />
  <div class="field">
    <label for="reply-body">Message to {clientLabel}</label>
    <textarea id="reply-body" name="body" maxlength="12000" rows="10">{draft?.body || ''}</textarea>
  </div>

  <div class="field" data-reply-files data-endpoint={`/api/admin/tickets/${ticket.ref}/attachments`}>
    <label for="reply-files">Attach files</label>
    <input id="reply-files" type="file" multiple accept=".pptx,.docx,.xlsx,.pdf,.png,.jpg,.jpeg,.webp,.txt,.md" data-file-picker aria-describedby="reply-files-help" />
    <p class="hint" id="reply-files-help">Word, PowerPoint, Excel, PDF, images or text. Up to 6 files, 15 MB each. They stay private until you send.</p>
    <button type="button" class="btn btn-ghost" data-retry-upload hidden>Retry upload</button>
    <ul class="file-rows" data-file-list>
      {files.map((file) => (
        <li><a class="fname" href={`/api/admin/files/${file.id}`}>{file.filename}</a><span class="fsize">{(file.size / 1048576).toFixed(1)} MB</span><button type="button" class="fremove" data-remove-file={file.id} aria-label={`Remove ${file.filename}`}>×</button></li>
      ))}
    </ul>
  </div>

  <div class="actions">
    <button class="btn btn-ghost" type="submit" name="action" value="save_draft">Save draft</button>
    <button class="btn btn-accent" type="submit" name="action" value="send_reply" data-after="waiting">Send and wait for reply</button>
    <button class="btn" type="submit" name="action" value="send_reply" data-after="done">Send and resolve</button>
  </div>
  <input type="hidden" name="after" value="waiting" />
  <p class="hint">The client gets an email saying you replied, with a link back here. The message itself stays on the desk.</p>
  <p role="status" data-outcome>{draft?.body && draft?.source === 'owner' ? 'Draft saved.' : ''}</p>
</form>
{aiEnabled && (
  <form method="POST" action={`/api/admin/tickets/${ticket.ref}/ai-draft`} data-json-form data-ai-draft style="margin-top:12px;">
    <input type="hidden" name="draft_revision" value={draft?.revision ?? ''} />
    <button class="btn btn-ghost" type="submit">{draft?.body ? 'Replace with a new AI draft' : 'Draft with AI'}</button>
    <p class="hint">Takes up to half a minute. Claude reads the request and the conversation, never your private notes.</p>
    <p role="status" data-outcome></p>
  </form>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-reply-files]').forEach((panel) => {
    const form = panel.closest('form') as HTMLFormElement;
    const picker = panel.querySelector<HTMLInputElement>('[data-file-picker]')!;
    const list = panel.querySelector<HTMLElement>('[data-file-list]')!;
    const retry = panel.querySelector<HTMLButtonElement>('[data-retry-upload]')!;
    const notice = form.querySelector<HTMLElement>('[data-outcome]')!;
    const field = (name: string) => form.querySelector<HTMLInputElement>(`[name=${name}]`)!;
    let pending: { file: File; key: string }[] = [];
    let index = 0;
    let draftSaved = false;

    const refresh = (result: any) => {
      if (result.draft) { field('draft_id').value = String(result.draft.id); field('draft_revision').value = String(result.draft.revision); }
      if (result.ticket_revision !== undefined) field('ticket_revision').value = String(result.ticket_revision);
      if (!result.attachments) return;
      list.replaceChildren(...result.attachments.map((file: any) => {
        const row = document.createElement('li');
        const link = Object.assign(document.createElement('a'), { className: 'fname', href: `/api/admin/files/${file.id}`, textContent: file.filename });
        const size = Object.assign(document.createElement('span'), { className: 'fsize', textContent: `${(file.size / 1048576).toFixed(1)} MB` });
        const remove = Object.assign(document.createElement('button'), { type: 'button', className: 'fremove', textContent: '×' });
        remove.dataset.removeFile = String(file.id);
        remove.setAttribute('aria-label', `Remove ${file.filename}`);
        row.append(link, size, remove);
        return row;
      }));
    };
    const call = async (url: string, method: string, body: FormData) => {
      const response = await fetch(url, { method, body, headers: { accept: 'application/json' } });
      if (!response.headers.get('content-type')?.includes('application/json')) throw new Error('Your sign-in could not be confirmed. Your draft is still here.');
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.error || 'The file could not be saved.');
      refresh(result);
      return result;
    };
    const draftFields = () => {
      const data = new FormData();
      for (const name of ['ticket_revision', 'draft_id', 'draft_revision']) data.set(name, field(name).value);
      return data;
    };
    const busy = async (work: () => Promise<void>) => {
      if (form.dataset.busy === 'true') return;
      form.dataset.busy = 'true';
      const controls = Array.from(form.querySelectorAll<HTMLButtonElement | HTMLInputElement | HTMLTextAreaElement>('button,input,textarea'));
      const before = controls.map((control) => control.disabled);
      controls.forEach((control) => { control.disabled = true; });
      try { await work(); }
      catch (error) { notice.textContent = error instanceof Error ? error.message : 'The file could not be saved.'; retry.hidden = !pending.length; }
      finally { controls.forEach((control, i) => { control.disabled = before[i]; }); form.dataset.busy = 'false'; }
    };
    // Save the draft first, then upload; a failed upload retries before any
    // further save, so a lost response can never leave the draft revision stale.
    const upload = () => busy(async () => {
      if (!draftSaved) {
        const data = draftFields();
        data.set('body', form.querySelector<HTMLTextAreaElement>('[name=body]')!.value);
        data.set('action', 'save_draft');
        data.set('for_files', '1');
        notice.textContent = 'Saving draft…';
        await call(form.getAttribute('action')!, 'POST', data);
        form.dataset.dirty = 'false';
        draftSaved = true;
      }
      for (; index < pending.length; index += 1) {
        const { file, key } = pending[index];
        notice.textContent = `Attaching ${file.name}…`;
        const data = draftFields();
        data.set('idempotency_key', key);
        data.set('file', file);
        await call(panel.dataset.endpoint!, 'POST', data);
      }
      pending = [];
      picker.value = '';
      retry.hidden = true;
      notice.textContent = 'Files attached. Draft saved.';
    });
    picker.addEventListener('change', () => {
      pending = Array.from(picker.files || []).map((file) => ({ file, key: crypto.randomUUID() }));
      index = 0;
      draftSaved = false;
      upload();
    });
    retry.addEventListener('click', upload);
    list.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-file]');
      if (!button) return;
      busy(async () => {
        const data = draftFields();
        data.set('attachment_id', button.dataset.removeFile!);
        notice.textContent = 'Removing file…';
        await call(panel.dataset.endpoint!, 'DELETE', data);
        notice.textContent = 'File removed.';
      });
    });
    form.querySelectorAll<HTMLButtonElement>('[data-after]').forEach((button) => {
      button.addEventListener('click', () => { field('after').value = button.dataset.after!; });
    });
  });
</script>
