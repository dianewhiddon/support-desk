---
/* One message in a conversation. tone: client | owner | note.
   side: end puts the viewer's own messages on the right. */
import type { ThreadFile } from '../lib/models';
interface Props {
  tone?: string;
  side?: string;
  name?: string;
  role?: string;
  time?: string;
  status?: string;
  statusTone?: string;
  earlier?: boolean;
  files?: ThreadFile[];
}
const {
  tone = 'client',
  side = 'start',
  name = '',
  role = '',
  time = '',
  status = '',
  statusTone = '',
  earlier = false,
  files = [],
} = Astro.props;
const audio = files.filter((file) => file.kind === 'audio');
const downloads = files.filter((file) => file.kind !== 'audio');
---

<article class:list={['thread-msg', `is-${tone}`, `on-${side}`]} data-earlier={earlier || undefined}>
  <header class="thread-msg-head">
    <span class="thread-avatar" aria-hidden="true">
      {(name || '?').trim().charAt(0).toUpperCase()}
    </span>
    <div class="thread-who">
      <strong>{name}</strong>
      {role && <span>{role}</span>}
    </div>
    {(time || status) && (
      <div class="thread-meta">
        {time && <span>{time}</span>}
        {status && <span class:list={['delivery-tag', statusTone]}>{status}</span>}
      </div>
    )}
  </header>
  <div class="thread-msg-body">
    <slot />
  </div>
  {files.length > 0 && (
    <div class="thread-files">
      {audio.map((file) => (
        <audio controls preload="none" src={file.href}></audio>
      ))}
      {downloads.map((file) => (
        <a class="thread-file" href={file.href} target="_blank" rel="noopener noreferrer">
          {file.kind === 'link' ? (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M9.5 2.5h4v4M13.5 2.5 7.5 8.5M12 9.5v3a1 1 0 0 1-1 1H3.5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3" />
            </svg>
          ) : (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M13.2 7.6 8 12.8a3.2 3.2 0 0 1-4.6-4.6l5.4-5.4a2.1 2.1 0 0 1 3 3L6.5 11a1.1 1.1 0 0 1-1.5-1.5l4.9-4.9" />
            </svg>
          )}
          <span>{file.label}</span>
        </a>
      ))}
    </div>
  )}
</article>
