{
  "name": "support-desk",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "node --test test/*.test.js",
    "preview": "astro preview",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file=scripts/seed-local.sql",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "types": "wrangler types --include-runtime=false --env-interface Env",
    "verify": "npm run lint && npm run format:check && npm test && npm run check && npm run build",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@astrojs/cloudflare": "^14.2.1",
    "astro": "^7.2.2",
    "svix": "^1.76.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20261016.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "wrangler": "^4.123.0"
  },
  "description": "Self-hosted support requests, client conversations, private reply drafts and optional AI assistance.",
  "repository": {
    "type": "git",
    "url": "https://github.com/dianewhiddon/support-desk.git"
  }
}
